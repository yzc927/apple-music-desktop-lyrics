<Window x:Class="AppleMusicDesktopLyrics.LyricsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enhanced LRC 编辑器" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#FFF5F6F8"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Enhanced LRC 编辑器" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="F8：当前行按播放位置打点并前进　Shift+F8：当前词打点并前进　Alt+←/→：当前行 ±50ms"
                       Margin="0,5,0,10" Foreground="#FF6F7684" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="播放位置设为行时间 (F8)" Padding="10,6" Margin="0,0,8,6" Click="StampLine_Click" />
            <Button Content="当前行 −50ms" Padding="10,6" Margin="0,0,8,6" Click="LineEarlier_Click" />
            <Button Content="当前行 +50ms" Padding="10,6" Margin="0,0,8,6" Click="LineLater_Click" />
            <Button Content="整首 −500ms" Padding="10,6" Margin="0,0,8,6" Click="AllEarlier_Click" />
            <Button Content="整首 +500ms" Padding="10,6" Margin="0,0,8,6" Click="AllLater_Click" />
            <Button Content="新增行" Padding="10,6" Margin="0,0,8,6" Click="AddLine_Click" />
            <Button Content="删除行" Padding="10,6" Margin="0,0,8,6" Click="RemoveLine_Click" />
        </WrapPanel>

        <TabControl x:Name="EditorTabs" Grid.Row="2" SelectionChanged="EditorTabs_SelectionChanged">
            <TabItem Header="表格与打点">
                <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                          CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          SelectionChanged="LinesGrid_SelectionChanged" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行时间" Binding="{Binding TimeText, UpdateSourceTrigger=LostFocus}"
                                            Width="110" />
                        <DataGridTextColumn Header="歌词" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                            Width="*" />
                        <DataGridTextColumn Header="词级时间" Binding="{Binding TimingSummary}" IsReadOnly="True"
                                            Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="LRC 源码">
                <TextBox x:Name="SourceEditor" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="14" Padding="10" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="SourceEditor_TextChanged" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="White"
                BorderBrush="#FFD9DDE5" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <TextBlock Text="当前行词段" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <Button Content="自动分词" Padding="9,4" Margin="0,0,8,6" Click="SplitWords_Click" />
                    <Button Content="当前词打点 (Shift+F8)" Padding="9,4" Margin="0,0,8,6" Click="StampWord_Click" />
                    <Button Content="播放位置设为行尾" Padding="9,4" Margin="0,0,8,6" Click="StampEnd_Click" />
                    <Button Content="清除词级时间" Padding="9,4" Margin="0,0,8,6" Click="ClearWords_Click" />
                </WrapPanel>
                <ListBox x:Name="SegmentsList" Grid.Row="1" ItemsSource="{Binding SelectedLine.Segments}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         MinHeight="48">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" Margin="2" Background="#FFF0F2F6" CornerRadius="4">
                                <TextBlock Text="{Binding Display}" FontFamily="Consolas" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="ValidationText" VerticalAlignment="Center" Foreground="#FF6F7684" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="84" Margin="0,0,8,0" Padding="10,6" Click="Cancel_Click" />
                <Button Content="保存本地歌词" Width="126" Padding="10,6" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
