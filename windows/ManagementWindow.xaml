<Window x:Class="AppleMusicDesktopLyrics.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词管理" Width="820" Height="720" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFF3F6FB"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6366F1" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5558E8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF4649D2" />
        <SolidColorBrush x:Key="InkBrush" Color="#FF202636" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF70798B" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFE2E7F0" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE5EAF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF27324A" BlurRadius="14" ShadowDepth="2" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#FFDCE2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFC2414B" />
            <Setter Property="Background" Value="#FFFFF7F7" />
            <Setter Property="BorderBrush" Value="#FFF0D4D7" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFAFBFD" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#FFDCE2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#556366F1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TextBoxChrome" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFAFBFD" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#FFDCE2EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,3" CornerRadius="9,9,0,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#FFEDEFFC" />
                                <Setter Property="Foreground" Value="#FF4C50C9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="White" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF4245C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="桌面歌词管理" FontSize="25" FontWeight="SemiBold" Foreground="#FF1D2433" />
            <TextBlock Text="常用设置与歌手配色分开管理；无需拉高窗口。"
                       Margin="0,5,0,0" Foreground="#FF7B8290" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="常用设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <Border Padding="18" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="当前歌手" Foreground="#FF7B8290" FontSize="12" />
                                    <TextBlock x:Name="CurrentArtistText" Margin="0,5,0,0" FontSize="20"
                                               FontWeight="SemiBold" Foreground="#FF252B38"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentModeText" Margin="0,5,0,0" Foreground="#FF7B8290" />
                                    <TextBlock x:Name="LyricsSourceText" Margin="0,3,0,0" Foreground="#FF7B8290" />
                                </StackPanel>
                                <Border x:Name="CurrentPalettePreview" Grid.Column="1" Height="46"
                                        Margin="16,0,0,0" CornerRadius="10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,6,0" Padding="18" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="自动配色" FontWeight="SemiBold" FontSize="15" />
                                    <Button x:Name="AutoModeButton" Margin="0,11,0,0"
                                            HorizontalAlignment="Left" Click="AutoModeButton_Click" />
                                    <TextBlock Text="合作歌手使用渐变；组合按整体身份处理。"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="18"
                                    Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="歌词字体" FontWeight="SemiBold" FontSize="15" />
                                    <ComboBox x:Name="FontComboBox" Margin="0,11,0,0" Height="34" Padding="10,4"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="FontComboBox_SelectionChanged" />
                                    <TextBlock Text="仅列出本机已安装的精选字体。"
                                               Margin="0,8,0,0" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="18" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="启动行为" FontWeight="SemiBold" FontSize="15" />
                                <CheckBox x:Name="StartupCheckBox" Margin="0,12,0,0"
                                          Content="随 Windows 登录启动桌面歌词"
                                          Checked="StartupCheckBox_Changed"
                                          Unchecked="StartupCheckBox_Changed" />
                                <TextBlock x:Name="StartupStatusText" Margin="0,7,0,0"
                                           TextWrapping="Wrap" Foreground="#FF6F7684" />
                                <TextBlock Text="新安装默认关闭；旧版本已经开启的电脑会自动保留。此设置与“跟随 Apple Music 自动显示 / 隐藏”互不影响。"
                                           Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FF6F7684" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="18" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="时间与歌词版本" FontWeight="SemiBold" FontSize="15" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="慢 0.5 秒" Click="Slow_Click" />
                                        <Button Content="归零" Click="Reset_Click" />
                                        <Button Content="快 0.5 秒" Click="Fast_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="OffsetText" Margin="0,7,0,0" Foreground="#FF6F7684" />
                                    <TextBlock Text="歌词版本" Margin="0,14,0,7" Foreground="#FF6F7684" />
                                    <WrapPanel>
                                        <Button Content="◀" Width="42" Padding="6,5" Click="PreviousLyrics_Click" />
                                        <Button Content="▶" Width="42" Padding="6,5" Click="NextLyrics_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LyricsVersionText" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                    <TextBlock x:Name="LyricsConfidenceText" Margin="0,5,0,0"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="匹配置信度：尚未评估" />
                                    <Button x:Name="AutoTimingButton" Margin="0,14,0,0"
                                            HorizontalAlignment="Left" Click="AutoTimingButton_Click" />
                                    <TextBlock Text="默认开启；以 Apple Music 当前高亮歌词校准 LRCLIB 时间。"
                                               Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#FFE7E9ED" />

                                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                    <TextBlock Text="显示与本地歌词" FontWeight="SemiBold" FontSize="15" />
                                    <Button x:Name="KaraokeModeButton" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" Click="KaraokeModeButton_Click" />
                                    <TextBlock x:Name="KaraokeModeDescription" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                    <TextBlock Text="本地歌词与缓存" Margin="0,16,0,8"
                                               FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <Button Content="导入 .lrc" Margin="0,0,8,8" Click="ImportLyrics_Click" />
                                        <Button Content="导出当前 .lrc" Margin="0,0,8,8" Click="ExportLyrics_Click" />
                                        <Button Content="编辑当前歌词" Margin="0,0,8,8" Click="EditLyrics_Click" />
                                        <Button Content="删除本地覆盖" Margin="0,0,8,8" Click="RemoveLocalLyrics_Click" />
                                        <Button Content="清空歌词缓存" Margin="0,0,8,8" Click="ClearLyricsCache_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LocalLyricsStatusText" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="歌手配色">
                <Border Margin="14" Padding="18" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="190" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="110" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="歌手配色管理" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#FF252B38" />
                                <TextBlock Text="为单人歌手或组合设置一个或多个颜色；多个颜色按顺序生成渐变。"
                                           Margin="0,5,0,0" Foreground="#FF6F7684" />
                                <TextBlock Text="歌手 / 组合名称" Margin="0,14,0,0" Foreground="#FF6F7684" />
                                <TextBox x:Name="ArtistNameEditor" Margin="0,5,0,0" Height="34" Padding="8,4"
                                         ToolTip="歌手或组合名称" />

                                <TextBlock Text="当前配色" Margin="0,14,0,0" FontWeight="SemiBold"
                                           Foreground="#FF4A5261" />
                                <TextBlock Text="点击色块打开调色板；右键删除。多个颜色按顺序生成渐变，最多 5 个。"
                                           Margin="0,4,0,8" Foreground="#FF6F7684" />
                                <WrapPanel x:Name="ArtistColorChips" />
                                <Button Content="＋ 添加自定义颜色" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Click="AddArtistColor_Click" />

                                <TextBlock Text="常用颜色" Margin="0,14,0,0" FontWeight="SemiBold"
                                           Foreground="#FF4A5261" />
                                <TextBlock Text="单色时点击会直接替换；已有渐变时点击会追加。"
                                           Margin="0,4,0,8" Foreground="#FF6F7684" />
                                <WrapPanel x:Name="CommonArtistColors" />

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="使用当前歌手" Margin="0,0,8,8" Click="UseCurrentArtist_Click" />
                                    <Button Content="新增 / 保存" Margin="0,0,8,8" Click="SaveArtistPalette_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="删除自定义" Margin="0,0,8,8" Click="DeleteArtistPalette_Click"
                                            Style="{StaticResource DangerButtonStyle}" />
                                    <Button Content="导入配色库" Margin="0,0,8,8" Click="ImportArtistPalette_Click" />
                                    <Button Content="导出配色库" Margin="0,0,8,8" Click="ExportArtistPalette_Click" />
                                </WrapPanel>

                                <Expander Header="高级：手动编辑颜色代码" Margin="0,4,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="从左到右输入颜色代码，例如 #F25F7C, #55B8FF。"
                                                   Foreground="#FF6F7684" />
                                        <TextBox x:Name="ArtistColorsEditor" Margin="0,6,0,0" Height="34" Padding="8,4"
                                                 TextChanged="ArtistColorsEditor_TextChanged" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,10,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="歌手配色一览" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#FF252B38" />
                                <TextBlock Text="点击一行可载入编辑；内置配色不会被删除。"
                                           Margin="0,3,0,0" Foreground="#FF6F7684" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="颜色代码 / 预览" VerticalAlignment="Bottom"
                                       Foreground="#FF8A909C" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ArtistList" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
