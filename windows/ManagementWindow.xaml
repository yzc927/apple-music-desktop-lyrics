<Window x:Class="AppleMusicDesktopLyrics.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词管理" Width="720" Height="840" MinWidth="600" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#FFF5F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9DDE4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="桌面歌词管理" FontSize="25" FontWeight="SemiBold" Foreground="#FF1D2433" />
            <TextBlock Text="管理入口仅在系统托盘右键菜单中提供" Margin="0,5,0,0" Foreground="#FF7B8290" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="18" CornerRadius="12" Background="White">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前歌手" Foreground="#FF7B8290" FontSize="12" />
                    <TextBlock x:Name="CurrentArtistText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#FF252B38" />
                    <TextBlock x:Name="CurrentModeText" Margin="0,5,0,0" Foreground="#FF7B8290" />
                    <TextBlock x:Name="LyricsSourceText" Margin="0,3,0,0" Foreground="#FF7B8290" />
                </StackPanel>
                <Border x:Name="CurrentPalettePreview" Grid.Column="1" Height="50" CornerRadius="10" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="18" CornerRadius="12" Background="White">
            <StackPanel>
                <TextBlock Text="自动配色" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AutoModeButton" Click="AutoModeButton_Click" />
                    <TextBlock Text="单人固定代表色；合作歌手使用渐变；组合按整体身份处理。"
                               VerticalAlignment="Center" Foreground="#FF6F7684" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="18" CornerRadius="12" Background="White">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="歌词字体" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="仅显示本机已安装的精选字体" Margin="0,4,0,0" Foreground="#FF6F7684" />
                </StackPanel>
                <ComboBox x:Name="FontComboBox" Grid.Column="1" Height="34" Padding="10,4"
                          VerticalContentAlignment="Center" SelectionChanged="FontComboBox_SelectionChanged" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="18" CornerRadius="12" Background="White">
            <StackPanel>
                <TextBlock Text="当前歌曲时间偏移" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="慢 0.5 秒" Click="Slow_Click" />
                    <Button Content="归零" Click="Reset_Click" />
                    <Button Content="快 0.5 秒" Click="Fast_Click" />
                    <TextBlock x:Name="OffsetText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FF6F7684" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="歌词版本" Width="72" VerticalAlignment="Center" Foreground="#FF6F7684" />
                    <Button Content="◀" Width="42" Padding="6,5" Click="PreviousLyrics_Click" />
                    <Button Content="▶" Width="42" Padding="6,5" Click="NextLyrics_Click" />
                    <TextBlock x:Name="LyricsVersionText" Margin="8,0,0,0" MaxWidth="420"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#FF6F7684" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="AutoTimingButton" Click="AutoTimingButton_Click" />
                    <TextBlock Text="实验功能；默认关闭，LRCLIB 不准时再尝试开启。"
                               VerticalAlignment="Center" Foreground="#FF6F7684" />
                </StackPanel>
                <Border Height="1" Margin="0,16,0,14" Background="#FFE7E9ED" />
                <TextBlock Text="歌词显示模式" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="KaraokeModeButton" Click="KaraokeModeButton_Click" />
                    <TextBlock x:Name="KaraokeModeDescription" VerticalAlignment="Center"
                               Foreground="#FF6F7684" />
                </StackPanel>
                <Border Height="1" Margin="0,14,0,12" Background="#FFE7E9ED" />
                <TextBlock Text="本地歌词与缓存" FontWeight="SemiBold" FontSize="15" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="导入 .lrc" Click="ImportLyrics_Click" />
                    <Button Content="编辑当前歌词" Click="EditLyrics_Click" />
                    <Button Content="删除本地覆盖" Click="RemoveLocalLyrics_Click" />
                    <Button Content="清空歌词缓存" Click="ClearLyricsCache_Click" />
                </WrapPanel>
                <TextBlock x:Name="LocalLyricsStatusText" Margin="0,8,0,0" Foreground="#FF6F7684" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="歌手配色管理" FontSize="16" FontWeight="SemiBold" Foreground="#FF252B38" />
            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ArtistNameEditor" Height="32" Padding="8,4" ToolTip="歌手或组合名称" />
                    <TextBox x:Name="ArtistColorsEditor" Grid.Column="1" Margin="8,0,0,0" Height="32" Padding="8,4"
                             ToolTip="从左到右输入颜色，例如 #F25F7C, #55B8FF" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="使用当前歌手" Click="UseCurrentArtist_Click" />
                    <Button Content="新增 / 保存" Click="SaveArtistPalette_Click" />
                    <Button Content="删除自定义" Click="DeleteArtistPalette_Click" />
                    <Button Content="导入配色库" Click="ImportArtistPalette_Click" />
                    <Button Content="导出配色库" Click="ExportArtistPalette_Click" />
                </WrapPanel>
                <TextBlock Text="多个颜色按输入顺序生成渐变；点击下方歌手可载入编辑。"
                           Margin="0,5,0,0" Foreground="#FF6F7684" />
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ArtistList" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
