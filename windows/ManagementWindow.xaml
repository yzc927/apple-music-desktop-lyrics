<Window x:Class="AppleMusicDesktopLyrics.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词管理" Width="820" Height="720" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFF5F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9DDE4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,14">
            <TextBlock Text="桌面歌词管理" FontSize="25" FontWeight="SemiBold" Foreground="#FF1D2433" />
            <TextBlock Text="常用设置与歌手配色分开管理；无需拉高窗口。"
                       Margin="0,5,0,0" Foreground="#FF7B8290" />
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="#FFDDE1E8">
            <TabItem Header="常用设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14">
                        <Border Padding="18" CornerRadius="12" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="当前歌手" Foreground="#FF7B8290" FontSize="12" />
                                    <TextBlock x:Name="CurrentArtistText" Margin="0,5,0,0" FontSize="20"
                                               FontWeight="SemiBold" Foreground="#FF252B38"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CurrentModeText" Margin="0,5,0,0" Foreground="#FF7B8290" />
                                    <TextBlock x:Name="LyricsSourceText" Margin="0,3,0,0" Foreground="#FF7B8290" />
                                </StackPanel>
                                <Border x:Name="CurrentPalettePreview" Grid.Column="1" Height="46"
                                        Margin="16,0,0,0" CornerRadius="10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,6,0" Padding="18" CornerRadius="12" Background="White">
                                <StackPanel>
                                    <TextBlock Text="自动配色" FontWeight="SemiBold" FontSize="15" />
                                    <Button x:Name="AutoModeButton" Margin="0,11,0,0"
                                            HorizontalAlignment="Left" Click="AutoModeButton_Click" />
                                    <TextBlock Text="合作歌手使用渐变；组合按整体身份处理。"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="18"
                                    CornerRadius="12" Background="White">
                                <StackPanel>
                                    <TextBlock Text="歌词字体" FontWeight="SemiBold" FontSize="15" />
                                    <ComboBox x:Name="FontComboBox" Margin="0,11,0,0" Height="34" Padding="10,4"
                                              VerticalContentAlignment="Center"
                                              SelectionChanged="FontComboBox_SelectionChanged" />
                                    <TextBlock Text="仅列出本机已安装的精选字体。"
                                               Margin="0,8,0,0" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="18" CornerRadius="12" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="时间与歌词版本" FontWeight="SemiBold" FontSize="15" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="慢 0.5 秒" Click="Slow_Click" />
                                        <Button Content="归零" Click="Reset_Click" />
                                        <Button Content="快 0.5 秒" Click="Fast_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="OffsetText" Margin="0,7,0,0" Foreground="#FF6F7684" />
                                    <TextBlock Text="歌词版本" Margin="0,14,0,7" Foreground="#FF6F7684" />
                                    <WrapPanel>
                                        <Button Content="◀" Width="42" Padding="6,5" Click="PreviousLyrics_Click" />
                                        <Button Content="▶" Width="42" Padding="6,5" Click="NextLyrics_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LyricsVersionText" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                    <Button x:Name="AutoTimingButton" Margin="0,14,0,0"
                                            HorizontalAlignment="Left" Click="AutoTimingButton_Click" />
                                    <TextBlock Text="默认开启；以 Apple Music 当前高亮歌词校准 LRCLIB 时间。"
                                               Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#FFE7E9ED" />

                                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                    <TextBlock Text="显示与本地歌词" FontWeight="SemiBold" FontSize="15" />
                                    <Button x:Name="KaraokeModeButton" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" Click="KaraokeModeButton_Click" />
                                    <TextBlock x:Name="KaraokeModeDescription" Margin="0,7,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                    <TextBlock Text="本地歌词与缓存" Margin="0,16,0,8"
                                               FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <Button Content="导入 .lrc" Margin="0,0,8,8" Click="ImportLyrics_Click" />
                                        <Button Content="编辑当前歌词" Margin="0,0,8,8" Click="EditLyrics_Click" />
                                        <Button Content="删除本地覆盖" Margin="0,0,8,8" Click="RemoveLocalLyrics_Click" />
                                        <Button Content="清空歌词缓存" Margin="0,0,8,8" Click="ClearLyricsCache_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="LocalLyricsStatusText" Margin="0,2,0,0"
                                               TextWrapping="Wrap" Foreground="#FF6F7684" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="歌手配色">
                <Border Margin="14" Padding="18" CornerRadius="12" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="歌手配色管理" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#FF252B38" />
                            <TextBlock Text="为单人歌手或组合设置一个或多个颜色；多个颜色按顺序生成渐变。"
                                       Margin="0,5,0,0" Foreground="#FF6F7684" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="歌手 / 组合名称" Foreground="#FF6F7684" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="颜色列表（例如 #F25F7C, #55B8FF）"
                                       Foreground="#FF6F7684" />
                            <TextBox x:Name="ArtistNameEditor" Grid.Row="1" Margin="0,5,0,0"
                                     Height="34" Padding="8,4"
                                     ToolTip="歌手或组合名称" />
                            <TextBox x:Name="ArtistColorsEditor" Grid.Row="1" Grid.Column="1" Margin="8,5,0,0"
                                     Height="34" Padding="8,4"
                                     ToolTip="从左到右输入颜色，例如 #F25F7C, #55B8FF" />
                        </Grid>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="使用当前歌手" Margin="0,0,8,8" Click="UseCurrentArtist_Click" />
                            <Button Content="新增 / 保存" Margin="0,0,8,8" Click="SaveArtistPalette_Click" />
                            <Button Content="删除自定义" Margin="0,0,8,8" Click="DeleteArtistPalette_Click" />
                            <Button Content="导入配色库" Margin="0,0,8,8" Click="ImportArtistPalette_Click" />
                            <Button Content="导出配色库" Margin="0,0,8,8" Click="ExportArtistPalette_Click" />
                        </WrapPanel>
                        <TextBlock Grid.Row="3" Text="点击下方歌手可载入编辑；内置配色不会被删除。"
                                   Margin="0,0,0,9" Foreground="#FF6F7684" />
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ArtistList" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
