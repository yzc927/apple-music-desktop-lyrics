<Window x:Class="AppleMusicDesktopLyrics.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music 桌面歌词"
        Width="920" Height="150" MinWidth="360" MinHeight="100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Surface" CornerRadius="14" Background="#01000000"
            MouseEnter="Surface_MouseEnter" MouseLeave="Surface_MouseLeave"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown">
        <Grid>
            <!-- Keep the window's full hit area, but only tint a compact band behind
                 the lyrics.  This preserves the saved window size and font scale. -->
            <Border x:Name="HoverBackdrop" CornerRadius="14" Background="Transparent"
                    VerticalAlignment="Center" Height="72" IsHitTestVisible="False" />

            <StackPanel Margin="24,38,24,14" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="CurrentLine" Text="正在等待 Apple Music…"
                           Foreground="White" FontFamily="Microsoft YaHei UI"
                           FontSize="30" FontWeight="SemiBold" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="1" Opacity="0.95" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="CurrentHighlightLine" Text="正在等待 Apple Music…"
                           Foreground="#FFFF3B30" FontFamily="Microsoft YaHei UI"
                           FontSize="30" FontWeight="SemiBold" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="NextLine" Margin="0,8,0,0" Text=""
                       Foreground="#BFFFFFFF" FontFamily="Microsoft YaHei UI"
                       FontSize="19" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.9" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <Border x:Name="Toast" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,6,0,0" Padding="12,5" CornerRadius="9"
                    Background="#D9000000" IsHitTestVisible="False"
                    Panel.ZIndex="20">
                <TextBlock x:Name="ToastText" Foreground="White"
                           FontFamily="Microsoft YaHei UI" FontSize="13" />
            </Border>

            <StackPanel x:Name="Toolbar" Visibility="Collapsed" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Height" Value="27" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#80000000" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="SlowButton" ToolTip="歌词慢 0.5 秒" Click="SlowButton_Click">
                    <Grid Width="21" Height="19">
                        <Path Width="17" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                              Stroke="White" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform" Data="M18,10 H4 M4,10 L9,5 M4,10 L9,15 M13,6 V14" />
                        <TextBlock Text="0.5" Foreground="White" FontSize="6.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Button>
                <Button x:Name="FastButton" ToolTip="歌词快 0.5 秒" Click="FastButton_Click">
                    <Grid Width="21" Height="19">
                        <Path Width="17" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                              Stroke="White" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform" Data="M4,10 H18 M18,10 L13,5 M18,10 L13,15 M9,6 V14" />
                        <TextBlock Text="0.5" Foreground="White" FontSize="6.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Button>
                <Button x:Name="LockButton" ToolTip="锁定位置和大小" Click="LockButton_Click">
                    <Viewbox Width="20" Height="20">
                        <Path x:Name="LockIcon" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M8,11 V7 C8,3.7 10.7,1 14,1 C17.3,1 20,3.7 20,7 M5,11 H19 V22 H5 Z M12,15 V18" />
                    </Viewbox>
                </Button>
                <Button x:Name="PinButton" ToolTip="取消始终置顶" Click="PinButton_Click">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="24" Height="24">
                            <Path Fill="White" Data="M8,3 H16 L15,9 L19,13 V15 H13 V22 H11 V15 H5 V13 L9,9 Z" />
                            <Path x:Name="PinSlash" Visibility="Collapsed" Stroke="#FFFF6B6B" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" Data="M4,4 L20,20" />
                        </Grid>
                    </Viewbox>
                </Button>
                <Button x:Name="ColorButton" ToolTip="选择已唱歌词颜色" Click="ColorButton_Click">
                    <Viewbox Width="17" Height="17"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,2 C6.48,2 2,5.58 2,10 C2,13.31 4.69,16 8,16 H9.76 C10.45,16 11,16.55 11,17.24 C11,17.75 10.7,18.12 10.43,18.42 C9.55,19.42 10.26,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 M5.5,11 A1.5,1.5 0 1 1 5.5,8 A1.5,1.5 0 1 1 5.5,11 M8.5,7 A1.5,1.5 0 1 1 8.5,4 A1.5,1.5 0 1 1 8.5,7 M15.5,7 A1.5,1.5 0 1 1 15.5,4 A1.5,1.5 0 1 1 15.5,7 M18.5,11 A1.5,1.5 0 1 1 18.5,8 A1.5,1.5 0 1 1 18.5,11" /></Viewbox>
                </Button>
                <Button x:Name="AutoColorButton" ToolTip="按歌手自动配色" Click="AutoColorButton_Click">
                    <Viewbox Width="17" Height="17"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,1 L14,7 L20,9 L14,11 L12,17 L10,11 L4,9 L10,7 Z M19,14 L20.2,17.8 L24,19 L20.2,20.2 L19,24 L17.8,20.2 L14,19 L17.8,17.8 Z M4,14 L4.8,16.2 L7,17 L4.8,17.8 L4,20 L3.2,17.8 L1,17 L3.2,16.2 Z" /></Viewbox>
                </Button>
                <Button x:Name="LyricsModeButton" ToolTip="切换为卡拉 OK 模式" Click="LyricsModeButton_Click">
                    <Viewbox Width="18" Height="18">
                        <Path x:Name="LyricsModeIcon" Stroke="White" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent"
                              Data="M4,6 H20 M4,12 H20 M4,18 H15" />
                    </Viewbox>
                </Button>
                <Button x:Name="CloseButton" ToolTip="隐藏到系统托盘" Click="CloseButton_Click">
                    <Viewbox Width="15" Height="15"><Path Fill="White" Data="M5,4 L12,11 L19,4 L20,5 L13,12 L20,19 L19,20 L12,13 L5,20 L4,19 L11,12 L4,5 Z" /></Viewbox>
                </Button>
            </StackPanel>

            <ResizeGrip x:Name="Grip" Width="20" Height="20" Margin="0,0,4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Foreground="White" Opacity="0.65" />
        </Grid>
    </Border>
</Window>
