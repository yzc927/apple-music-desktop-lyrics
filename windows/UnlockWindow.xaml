<Window x:Class="AppleMusicDesktopLyrics.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="42" Height="36" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True">
    <Border Background="#D9000000" CornerRadius="3" Padding="7">
        <Button ToolTip="解锁歌词窗口" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="Unlock_Click">
            <Viewbox Width="21" Height="21">
                <Path Fill="Transparent" Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M7,11 V7 C7,3.7 9.2,1 12,1 C14.8,1 17,3.7 17,7 V11 M5,11 H19 V22 H5 Z M12,15 V18" />
            </Viewbox>
        </Button>
    </Border>
</Window>
